# Production configuration. Copy to .env.prod and fill in real values.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# --env-file is required, not optional: compose interpolates ${...} in the port
# mappings from this file, and `env_file:` inside a service would only reach the
# container's environment, not the compose file's own substitutions.
#
# .env.prod is gitignored. Nothing here is baked into the image.

# --- image -----------------------------------------------------------------
# The tag the pipeline built. Every environment runs this same artefact.
IMAGE_TAG=1.0.1

# --- networking ------------------------------------------------------------
# Host port. 8080 is Jenkins on this machine - do not use it.
APP_HOST_PORT=8091
# Port the app listens on inside the container. Same in every environment.
APP_PORT=8080

# --- runtime ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# --- database --------------------------------------------------------------
# DB_HOST/DB_PORT are set by the compose file to the db service; they are not
# listed here because staging and production each own their database container.
DB_NAME=robotcontroller_prod
DB_USER=robot_prod
DB_PASSWORD=replace_with_a_real_production_password

# --- application -----------------------------------------------------------
# ADO | EF | Repository - which data-access implementation to register.
PERSISTENCE_PROVIDER=ADO
# Verbose per-request console logging. Off in production - it logs request bodies.
REQUEST_LOGGING_ENABLED=false
# Minutes a claimed job may be held before the sweep expires its lease.
WORK_DISPATCH_LEASE_MINUTES=5
